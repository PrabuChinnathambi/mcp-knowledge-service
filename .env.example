APP_NAME=mcp-knowledge-service
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://knowledge:knowledge_password@localhost:5432/knowledge_db
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSIONS=768
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
SUPPORTED_LLM_MODELS=qwen2.5:7b-instruct,llama3.2:3b,deepseek-r1:1.5b

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_RELEVANCE=0.30

API_KEY=dev-secret-key
MCP_USER_ID=alice
ALLOWED_TOOLS=list_collections,search_knowledge,ask_docs,ingest_document
